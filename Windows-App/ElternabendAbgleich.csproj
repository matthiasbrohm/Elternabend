<Project Sdk="Microsoft.NET.Sdk">
  <!-- Elternabend Abgleich für Windows. .NET Framework 4.8 ist auf Windows 10 und 11 schon dabei –
       die App braucht deshalb nichts extra installiert und bleibt eine kleine EXE. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ElternabendAbgleich</AssemblyName>
    <RootNamespace>ElternabendAbgleich</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Product>Elternabend Abgleich</Product>
    <Company>Gilde Elternabend</Company>
    <Description>Gleicht das Addon Elternabend mit gilde-elternabend.de ab</Description>
    <Copyright>Gilde Elternabend</Copyright>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <None Remove="Tests/**" />
    <EmbeddedResource Include="mond.ico" LogicalName="mond.ico" />
    <EmbeddedResource Include="mond-laeuft.ico" LogicalName="mond-laeuft.ico" />
    <EmbeddedResource Include="mond-problem.ico" LogicalName="mond-problem.ico" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
